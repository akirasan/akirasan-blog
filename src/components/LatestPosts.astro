---
import type { MarkdownInstance } from 'astro';

export interface Props {
	posts: MarkdownInstance<any>[];
}

const { posts } = Astro.props;

// El primer post será el grande destacado (featured) y el resto va al grid
const featuredPost = posts[0];
const gridPosts = posts.slice(1);
---

<section class="mx-auto max-w-6xl px-4 py-8">
	<!-- 1. Post destacado principal (Estilo Casper: Imagen a la izq / Texto a la der) -->
	{featuredPost && (
		<article class="mb-12 overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md dark:border-stone-800 dark:bg-stone-900 md:grid md:grid-cols-2">
			<a href={featuredPost.url} class="relative block aspect-video h-full min-h-[260px] overflow-hidden bg-stone-100 dark:bg-stone-800">
				{featuredPost.frontmatter.image?.src ? (
					<img
						src={featuredPost.frontmatter.image.src}
						alt={featuredPost.frontmatter.image.alt || featuredPost.frontmatter.title}
						class="h-full w-full object-cover transition duration-300 hover:scale-105"
					/>
				) : (
					<div class="flex h-full w-full items-center justify-center text-stone-400 font-mono text-sm">
						[Sin imagen]
					</div>
				)}
			</a>

			<div class="flex flex-col justify-between p-6 md:p-8">
				<div>
					<span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
						{featuredPost.frontmatter.tags?.[0] || 'General'}
					</span>
					<h2 class="mt-2 text-2xl font-extrabold text-stone-900 hover:text-blue-600 dark:text-stone-100 dark:hover:text-blue-400">
						<a href={featuredPost.url}>{featuredPost.frontmatter.title}</a>
					</h2>
					<p class="mt-3 line-clamp-4 text-sm text-stone-600 dark:text-stone-300">
						{featuredPost.frontmatter.description || featuredPost.frontmatter.excerpt || 'Lee el artículo completo pulsando aquí...'}
					</p>
				</div>

				<div class="mt-6 flex items-center gap-3 border-t border-stone-100 pt-4 text-xs text-stone-500 dark:border-stone-800 dark:text-stone-400">
					<span>{featuredPost.frontmatter.author || 'akirasan'}</span>
					<span>•</span>
					<time datetime={featuredPost.frontmatter.pubDate}>
						{String(featuredPost.frontmatter.pubDate).slice(0, 10)}
					</time>
				</div>
			</div>
		</article>
	)}

	<!-- 2. Cuadrícula de 3 columnas para el resto de artículos -->
	<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
		{gridPosts.map((post) => {
			const imgSrc = post.frontmatter.image?.src;
			const imgAlt = post.frontmatter.image?.alt || post.frontmatter.title;

			return (
				<article class="flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md dark:border-stone-800 dark:bg-stone-900">
					<a href={post.url} class="relative block aspect-video overflow-hidden bg-stone-100 dark:bg-stone-800">
						{imgSrc ? (
							<img
								src={imgSrc}
								alt={imgAlt}
								class="h-full w-full object-cover transition duration-300 hover:scale-105"
								loading="lazy"
							/>
						) : (
							<div class="flex h-full w-full items-center justify-center text-stone-400 font-mono text-xs">
								[Sin imagen]
							</div>
						)}
					</a>

					<div class="flex flex-1 flex-col justify-between p-5">
						<div>
							<span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
								{post.frontmatter.tags?.[0] || 'General'}
							</span>
							<h3 class="mt-2 text-lg font-bold leading-snug text-stone-900 hover:text-blue-600 dark:text-stone-100 dark:hover:text-blue-400">
								<a href={post.url}>{post.frontmatter.title}</a>
							</h3>
							<p class="mt-2 line-clamp-3 text-xs text-stone-600 dark:text-stone-400">
								{post.frontmatter.description || post.frontmatter.excerpt || ''}
							</p>
						</div>

						<div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-3 text-xs text-stone-500 dark:border-stone-800 dark:text-stone-400">
							<span>{post.frontmatter.author || 'akirasan'}</span>
							<time datetime={post.frontmatter.pubDate}>
								{String(post.frontmatter.pubDate).slice(0, 10)}
							</time>
						</div>
					</div>
				</article>
			);
		})}
	</div>

	<!-- Botón ver todos los posts -->
	<div class="mt-12 text-center">
		<a
			href="/posts"
			class="inline-block rounded-lg border border-stone-300 bg-white px-6 py-2.5 text-sm font-semibold text-stone-700 shadow-sm transition hover:bg-stone-50 dark:border-stone-700 dark:bg-stone-800 dark:text-stone-200 dark:hover:bg-stone-700"
		>
			Ver todos los posts →
		</a>
	</div>
</section>